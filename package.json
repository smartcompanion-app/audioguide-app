{
  "name": "smartcompanion-audioguide-app",
  "description": "SmartCompanion - Single Tour Audioguide App",
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "npm run build && wdio run wdio.conf.ts",
    "test:dev": "wdio run wdio.conf.ts --baseUrl=http://localhost:3333",
    "build:offline": "OFFLINE_SUPPORT=true stencil build",
    "test:offline": "npm run build:offline && TEST_OFFLINE=true wdio run wdio.conf.ts",
    "lint": "eslint src test",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/share": "^8.0.1",
    "@ionic/core": "^8.8.17",
    "@smartcompanion/data": "^1.0.0",
    "@smartcompanion/engraft": "^0.2.2",
    "@smartcompanion/native-audio-player": "^1.0.0",
    "@smartcompanion/services": "^1.0.0",
    "@smartcompanion/ui": "^1.0.0",
    "@stencil/core": "^4.39.0",
    "@stencil/sass": "^3.3.2",
    "@types/mocha": "^10.0.10",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/static-server-service": "^9.30.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "puppeteer-core": "^24.40.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.66.0",
    "workbox-build": "^7.3.0"
  },
  "license": "BSD-2-Clause",
  "lint-staged": {
    "{src,test}/**/*.{ts,tsx,js,css,scss,html,json}": "prettier --write"
  }
}
