{
  "name": "smartcompanion-audioguide-app",
  "description": "SmartCompanion - Single Tour Audioguide App",
  "version": "2026.0.0",
  "private": true,
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "npm run build && wdio run wdio.conf.ts",
    "test:dev": "wdio run wdio.conf.ts --baseUrl=http://localhost:3333",
    "build:offline": "OFFLINE_SUPPORT=true stencil build",
    "test:offline": "npm run build:offline && TEST_OFFLINE=true wdio run wdio.conf.ts",
    "lint": "eslint src test",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only",
    "release": "changeset tag",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/share": "^8.0.1",
    "@ionic/core": "^9.0.1",
    "@smartcompanion/data": "^1.0.2",
    "@smartcompanion/native-audio-player": "^1.0.0",
    "@smartcompanion/services": "^1.0.2",
    "@smartcompanion/ui": "^1.0.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@smartcompanion/engraft": "^0.2.2",
    "@stencil/core": "^4.44.2",
    "@stencil/sass": "^3.3.3",
    "@types/mocha": "^10.0.10",
    "@wdio/cli": "^9.31.4",
    "@wdio/local-runner": "^9.31.4",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/static-server-service": "^9.31.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "workbox-build": "^7.4.1"
  },
  "license": "BSD-2-Clause",
  "lint-staged": {
    "{src,test}/**/*.{ts,tsx,js,css,scss,html,json}": "prettier --write"
  }
}
