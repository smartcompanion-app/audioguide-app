{
  "name": "smartcompanion-audioguide-app",
  "description": "SmartCompanion - Single Tour Audioguide App",
  "version": "2026.1.0",
  "private": true,
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "prebuild": "npm run icons",
    "build": "stencil build",
    "prestart": "npm run icons",
    "start": "stencil build --dev --watch --serve",
    "test": "npm run build && wdio run wdio.conf.ts",
    "test:dev": "wdio run wdio.conf.ts --baseUrl=http://localhost:3333",
    "prebuild:offline": "npm run icons",
    "build:offline": "OFFLINE_SUPPORT=true stencil build",
    "test:offline": "npm run build:offline && TEST_OFFLINE=true wdio run wdio.conf.ts",
    "test:fonts": "node scripts/build-variant.mjs test/fixtures/fonts && TEST_FONTS=true wdio run wdio.conf.ts",
    "lint": "eslint src test",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only",
    "release": "changeset git-tag",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@ionic/core": "^9.0.10",
    "@smartcompanion/data": "^2.0.0",
    "@smartcompanion/native-audio-player": "^1.0.0",
    "@smartcompanion/services": "^2.0.0",
    "@smartcompanion/ui": "^2.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@smartcompanion/engraft": "^0.2.3",
    "@stencil/core": "^4.45.2",
    "@stencil/sass": "^3.3.3",
    "@types/mocha": "^10.0.10",
    "@wdio/cli": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "@wdio/static-server-service": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "workbox-build": "^7.4.1"
  },
  "license": "BSD-2-Clause",
  "lint-staged": {
    "{src,test}/**/*.{ts,tsx,js,css,scss,html,json}": "prettier --write"
  }
}
